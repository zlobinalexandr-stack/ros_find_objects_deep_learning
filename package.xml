<?xml version="1.0"?>
<package format="2">
  <name>find_object_3d_web</name>
  <version>0.1.0</version>
  <description>Publish depth-based 3D transforms for find_object_2d detections received over ROS topics.</description>
  <maintainer email="maintainer@example.com">ROS Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>cv_bridge</depend>
  <depend>find_object_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>python-numpy</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <test_depend>python-nose</test_depend>
  <export/>
</package>
