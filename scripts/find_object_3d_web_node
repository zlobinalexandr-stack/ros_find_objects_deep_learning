#!/usr/bin/env python
from __future__ import print_function

import threading

import numpy as np
import rospy
from cv_bridge import CvBridge, CvBridgeError
from find_object_2d.msg import ObjectsStamped
from geometry_msgs.msg import PointStamped, TransformStamped
import sensor_msgs.msg
import tf2_geometry_msgs  # noqa: F401: registers PointStamped conversions with TF2
import tf2_ros

from find_object_3d_web.geometry import (ExponentialPositionFilter, calibrate_depth,
                                         parse_detections, projected_center,
                                         project_pixel, robust_depth)
from find_object_3d_web.object_store import ObjectStore
from std_msgs.msg import Empty, Int32, Int32MultiArray


class SharedState(object):
    def __init__(self):
        self.lock = threading.RLock()
        self.rgb_shape = None
        self.depth = None
        self.depth_stamp = rospy.Time(0)
        self.depth_frame = ''
        self.camera_info = None
        self.pending_object_ids = {}


class Node(object):
    def __init__(self):
        self.state = SharedState()
        self.bridge = CvBridge()
        self.tf_broadcaster = tf2_ros.TransformBroadcaster()
        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer)
        self.output_frame = rospy.get_param('~output_frame', 'map')
        self.depth_scale = float(rospy.get_param('~depth_scale', 1.0))
        self.depth_calibration_scale = float(
            rospy.get_param('~depth_calibration_scale', 1.0))
        self.depth_calibration_offset = float(
            rospy.get_param('~depth_calibration_offset', 0.0))
        # Validate calibration at startup instead of silently publishing bad TF.
        calibrate_depth(0.0, self.depth_calibration_scale,
                        self.depth_calibration_offset)
        self.radius = int(rospy.get_param('~depth_window_radius', 4))
        self.min_depth = float(rospy.get_param('~min_depth', 0.05))
        self.max_depth = float(rospy.get_param('~max_depth', 100.0))
        self.max_depth_age = float(rospy.get_param('~max_depth_age', 0.5))
        self.position_filter = ExponentialPositionFilter(
            rospy.get_param('~position_smoothing_factor', 0.25),
            rospy.get_param('~position_filter_reset_time', 1.0))
        self.frame_prefix = rospy.get_param('~object_frame_prefix', 'object_')
        storage_directory = rospy.get_param(
            '~storage_directory', '~/.ros/find_object_3d_web/objects')
        self.store = ObjectStore(storage_directory)
        image_topic = rospy.get_param('~image_topic', '/video/image_raw')
        depth_topic = rospy.get_param('~depth_topic', '/depthnet/depth')
        info_topic = rospy.get_param('~camera_info_topic', '/video/camera_info')
        objects_topic = rospy.get_param('~objects_topic', '/objectsStamped')
        add_object_topic = rospy.get_param(
            '~add_object_topic', '/find_object_2d/add_object')
        remove_object_topic = rospy.get_param(
            '~remove_object_topic', '/find_object_3d_web/remove_object')
        object_list_topic = rospy.get_param(
            '~object_list_topic', '/find_object_3d_web/objects')
        detector_reload_topic = rospy.get_param(
            '~detector_reload_topic', '/find_object_3d_web/detector/reload')
        self.detector_reload_publisher = rospy.Publisher(
            detector_reload_topic, Empty, queue_size=1)
        self.object_list_publisher = rospy.Publisher(
            object_list_topic, Int32MultiArray, queue_size=1, latch=True)
        rospy.Subscriber(
            image_topic, sensor_msgs.msg.Image, self.image_callback,
            queue_size=1, buff_size=2 ** 24)
        rospy.Subscriber(
            depth_topic, sensor_msgs.msg.Image, self.depth_callback,
            queue_size=1, buff_size=2 ** 24)
        rospy.Subscriber(
            info_topic, sensor_msgs.msg.CameraInfo, self.info_callback, queue_size=1)
        rospy.Subscriber(objects_topic, ObjectsStamped, self.objects_callback, queue_size=10)
        # Own the public management topics so templates can be persisted before
        # the find_object_2d objects directory is rebuilt.
        rospy.Subscriber(
            add_object_topic, sensor_msgs.msg.CompressedImage,
            self.add_object_callback, queue_size=10)
        rospy.Subscriber(remove_object_topic, Int32, self.remove_object_callback, queue_size=10)

        self.publish_object_list()

        rospy.loginfo(
            'Topic-only object localization started: detections=%s add_object=%s '
            'remove_object=%s object_list=%s storage=%s',
            objects_topic, add_object_topic, remove_object_topic, object_list_topic,
            self.store.directory)

    def add_object_callback(self, msg):
        requested_id = msg.header.frame_id.strip()
        payload_size = len(msg.data)
        connection_header = getattr(msg, '_connection_header', None) or {}
        publisher = connection_header.get('callerid', '<unknown>')

        rospy.loginfo(
            'Object template upload observed: requested_id=%s format=%s bytes=%d '
            'publisher=%s',
            requested_id or '<automatic>', msg.format or '<unspecified>', payload_size,
            publisher)
        rospy.logdebug(
            'Add-object message details: stamp=%s frame_id=%r format=%r bytes=%d '
            'publisher=%s',
            msg.header.stamp, msg.header.frame_id, msg.format, payload_size, publisher)

        if not payload_size:
            rospy.logwarn('New object add request contains an empty image payload')
            return

        with self.state.lock:
            try:
                # find_object_2d uses both an empty frame and "0" to request
                # automatic object numbering.  rosbridge clients commonly send
                # the explicit "0" form.
                object_id = self.store.resolve_requested_id(requested_id)
            except ValueError:
                rospy.logwarn(
                    'Cannot add template: frame_id=%r is neither 0 (automatic) nor a '
                    'positive decimal object ID',
                    msg.header.frame_id)
                return

            try:
                self.store.save(object_id, msg.format, msg.data)
            except (IOError, OSError, ValueError) as error:
                rospy.logerr('Cannot persist template id=%d: %s', object_id, error)
                return
            self.state.pending_object_ids[object_id] = rospy.Time.now()

        msg.header.frame_id = str(object_id)
        self.detector_reload_publisher.publish(Empty())
        self.publish_object_list()
        rospy.loginfo(
            'Template id=%d saved; find_object_2d reload requested; its first occurrence '
            'in /objectsStamped will confirm that detection is active', object_id)

    def remove_object_callback(self, msg):
        object_id = int(msg.data)
        if object_id <= 0:
            rospy.logwarn('Cannot remove template: id=%d is not positive', object_id)
            return
        with self.state.lock:
            if not self.store.remove(object_id):
                rospy.logwarn('Cannot remove template id=%d: it is not stored', object_id)
                return
            self.state.pending_object_ids.pop(object_id, None)
            self.position_filter.reset(object_id)
        self.detector_reload_publisher.publish(Empty())
        self.publish_object_list()
        rospy.loginfo('Template id=%d removed; find_object_2d reload requested', object_id)

    def publish_object_list(self):
        with self.state.lock:
            object_ids = self.store.ids()
        self.object_list_publisher.publish(Int32MultiArray(data=object_ids))

    def image_callback(self, msg):
        # Only the dimensions are needed to map detection coordinates to a
        # differently sized depth image; no browser preview is produced.
        with self.state.lock:
            self.state.rgb_shape = (msg.height, msg.width)

    def depth_callback(self, msg):
        try:
            depth = self.bridge.imgmsg_to_cv2(msg, desired_encoding='passthrough')
            with self.state.lock:
                depth = np.asarray(depth, dtype=np.float32) * self.depth_scale
                self.state.depth = calibrate_depth(
                    depth, self.depth_calibration_scale,
                    self.depth_calibration_offset)
                self.state.depth_stamp = msg.header.stamp
                self.state.depth_frame = msg.header.frame_id
        except CvBridgeError as error:
            rospy.logwarn_throttle(5, 'Cannot convert depth image: %s', error)

    def info_callback(self, msg):
        with self.state.lock:
            self.state.camera_info = msg

    def objects_callback(self, msg):
        try:
            detections = list(parse_detections(msg.objects.data))
        except (ValueError, TypeError) as error:
            rospy.logwarn_throttle(5, 'Invalid find_object_2d detection: %s', error)
            return

        now = rospy.Time.now()
        with self.state.lock:
            for object_id, _, _, _ in detections:
                requested_at = self.state.pending_object_ids.pop(object_id, None)
                if requested_at is not None:
                    rospy.loginfo(
                        'Template processing confirmed by first detection: id=%d '
                        'elapsed=%.3fs', object_id, (now - requested_at).to_sec())

        with self.state.lock:
            depth = None if self.state.depth is None else self.state.depth.copy()
            info = self.state.camera_info
            rgb_shape = self.state.rgb_shape
            stamp, depth_frame = self.state.depth_stamp, self.state.depth_frame
        if depth is None:
            rospy.logwarn_throttle(5, 'Cannot localize detected objects: no depth image received')
            return
        if info is None:
            rospy.logwarn_throttle(5, 'Cannot localize detected objects: no CameraInfo received')
            return
        if rgb_shape is None:
            rospy.logwarn_throttle(5, 'Cannot localize detected objects: no RGB image received')
            return
        detection_stamp = msg.header.stamp
        if detection_stamp != rospy.Time(0) and stamp != rospy.Time(0) and abs((detection_stamp - stamp).to_sec()) > self.max_depth_age:
            rospy.logwarn_throttle(5, 'Ignoring detection: depth/image time difference is too large')
            return
        try:
            for object_id, width, height, homography in detections:
                u, v = projected_center(width, height, homography)
                # find_object_2d coordinates refer to RGB; map them when DepthNet has another resolution.
                du = u * depth.shape[1] / float(rgb_shape[1])
                dv = v * depth.shape[0] / float(rgb_shape[0])
                z = robust_depth(depth, du, dv, self.radius, self.min_depth, self.max_depth)
                if z is None:
                    rospy.logwarn_throttle(
                        5, 'Cannot localize object id=%d: no valid depth near pixel=(%.1f, %.1f)',
                        object_id, du, dv)
                    continue
                # CameraInfo normally describes RGB dimensions, so project the original RGB pixel.
                x, y, z = project_pixel(u, v, z, info)
                point = PointStamped()
                point.header.stamp = stamp if stamp != rospy.Time(0) else rospy.Time.now()
                # Projection uses the RGB CameraInfo model, therefore the result belongs
                # to its optical frame (registered depth is a prerequisite).
                point.header.frame_id = info.header.frame_id or depth_frame
                point.point.x = x
                point.point.y = y
                point.point.z = z
                if not point.header.frame_id:
                    rospy.logwarn_throttle(
                        5, 'Cannot localize object id=%d: camera optical frame is empty',
                        object_id)
                    continue
                try:
                    output_point = self.tf_buffer.transform(
                        point, self.output_frame, rospy.Duration(0.1))
                except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                        tf2_ros.ExtrapolationException) as error:
                    rospy.logwarn_throttle(
                        5, 'Cannot transform object id=%d from %s to %s; detection is not '
                        'published: %s', object_id, point.header.frame_id,
                        self.output_frame, error)
                    continue

                transform = TransformStamped()
                transform.header.stamp = output_point.header.stamp
                transform.header.frame_id = self.output_frame
                transform.child_frame_id = self.frame_prefix + str(object_id)
                with self.state.lock:
                    filtered_position = self.position_filter.update(
                        object_id,
                        (output_point.point.x, output_point.point.y, output_point.point.z),
                        output_point.header.stamp.to_sec())
                transform.transform.translation.x = filtered_position[0]
                transform.transform.translation.y = filtered_position[1]
                transform.transform.translation.z = filtered_position[2]
                transform.transform.rotation.w = 1.0
                try:
                    self.tf_broadcaster.sendTransform(transform)
                except rospy.ROSException as error:
                    rospy.logerr_throttle(
                        5, 'Cannot publish transform for object id=%d: %s', object_id, error)
                    continue
                rospy.loginfo_throttle(
                    1.0,
                    'Object detected: id=%d pixel=(%.1f, %.1f) position=(%.3f, %.3f, %.3f) '
                    'frame=%s tf=%s',
                    object_id, u, v, filtered_position[0], filtered_position[1],
                    filtered_position[2], transform.header.frame_id,
                    transform.child_frame_id)
        except (ValueError, TypeError) as error:
            rospy.logwarn_throttle(5, 'Invalid find_object_2d detection: %s', error)


if __name__ == '__main__':
    rospy.init_node('find_object_3d_web')
    Node()
    rospy.spin()
