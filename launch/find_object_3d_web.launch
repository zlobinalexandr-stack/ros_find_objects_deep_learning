<launch>
  <arg name="image_topic" default="/video/image_raw"/>
  <arg name="depth_topic" default="/depthnet/depth"/>
  <arg name="camera_info_topic" default="/video/camera_info"/>
  <arg name="objects_topic" default="/objectsStamped"/>
  <arg name="add_object_topic" default="/find_object_2d/add_object"/>
  <arg name="remove_object_topic" default="/find_object_3d_web/remove_object"/>
  <arg name="object_list_topic" default="/find_object_3d_web/objects"/>
  <!-- The detector GUI requires an X server. Keep launches usable over SSH and on robots. -->
  <arg name="detector_gui" default="false"/>
  <arg name="storage_directory" default="$(env HOME)/.ros/find_object_3d_web/objects"/>
  <arg name="detector_objects_path" default="$(env HOME)/.ros/find_object_3d_web/detector_objects"/>
  <arg name="detector_reload_topic" default="/find_object_3d_web/detector/reload"/>
  <arg name="depth_calibration_scale" default="1.0"/>
  <arg name="depth_calibration_offset" default="0.0"/>
  <arg name="output_frame" default="map"/>

  <node pkg="find_object_3d_web" type="find_object_2d_session_manager" name="find_object_2d_session_manager" output="screen">
    <param name="gui" value="$(arg detector_gui)"/>
    <param name="storage_directory" value="$(arg storage_directory)"/>
    <param name="detector_objects_path" value="$(arg detector_objects_path)"/>
    <param name="reload_topic" value="$(arg detector_reload_topic)"/>
    <remap from="image" to="$(arg image_topic)"/>
  </node>

  <node pkg="find_object_3d_web" type="find_object_3d_web_node" name="find_object_3d_web" output="screen">
    <rosparam command="load" file="$(find find_object_3d_web)/config/default.yaml"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="objects_topic" value="$(arg objects_topic)"/>
    <param name="add_object_topic" value="$(arg add_object_topic)"/>
    <param name="remove_object_topic" value="$(arg remove_object_topic)"/>
    <param name="object_list_topic" value="$(arg object_list_topic)"/>
    <param name="storage_directory" value="$(arg storage_directory)"/>
    <param name="detector_reload_topic" value="$(arg detector_reload_topic)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <!-- These params intentionally follow rosparam load so launch arguments override defaults. -->
    <param name="depth_calibration_scale" value="$(arg depth_calibration_scale)"/>
    <param name="depth_calibration_offset" value="$(arg depth_calibration_offset)"/>
  </node>
</launch>
