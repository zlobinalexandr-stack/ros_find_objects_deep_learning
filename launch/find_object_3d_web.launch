<launch>
  <arg name="image_topic" default="/video/image_raw"/>
  <arg name="depth_topic" default="/depthnet/depth"/>
  <arg name="camera_info_topic" default="/video/camera_info"/>
  <arg name="objects_topic" default="/objectsStamped"/>
  <arg name="add_object_topic" default="/find_object_2d/add_object"/>
  <arg name="remove_object_topic" default="/find_object_3d_web/remove_object"/>
  <arg name="object_list_topic" default="/find_object_3d_web/objects"/>
  <arg name="detector_add_topic" default="/find_object_3d_web/detector/add_object"/>
  <arg name="detector_remove_topic" default="/find_object_3d_web/detector/remove_object"/>
  <!-- The detector GUI requires an X server. Keep launches usable over SSH and on robots. -->
  <arg name="detector_gui" default="false"/>

  <node pkg="find_object_2d" type="find_object_2d" name="find_object_2d" output="screen">
    <param name="gui" value="$(arg detector_gui)"/>
    <remap from="image" to="$(arg image_topic)"/>
    <remap from="/find_object_2d/add_object" to="$(arg detector_add_topic)"/>
    <remap from="/find_object_2d/remove_object" to="$(arg detector_remove_topic)"/>
  </node>

  <node pkg="find_object_3d_web" type="find_object_3d_web_node" name="find_object_3d_web" output="screen">
    <rosparam command="load" file="$(find find_object_3d_web)/config/default.yaml"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="objects_topic" value="$(arg objects_topic)"/>
    <param name="add_object_topic" value="$(arg add_object_topic)"/>
    <param name="remove_object_topic" value="$(arg remove_object_topic)"/>
    <param name="object_list_topic" value="$(arg object_list_topic)"/>
    <param name="detector_add_topic" value="$(arg detector_add_topic)"/>
    <param name="detector_remove_topic" value="$(arg detector_remove_topic)"/>
  </node>
</launch>
